# Copied to /etc/cursor-race.env by setup.sh (mode 600, root only).
# Restart after editing: sudo systemctl restart cursor-race

PORT=8080
NODE_ENV=production

# The origin players reach you on. Google redirects back here, so it must match
# the Authorised redirect URI in the Google console (plus /auth/google/callback).
PUBLIC_URL=https://example.com

# Keeps sessions valid across restarts. setup.sh generates one if left blank.
SESSION_SECRET=

# Leave both blank to run without Google sign-in; everyone plays as a guest.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Game tuning, all optional.
#TABLE_CAP=10
#JOIN_WINDOW=30000
#ENTRY_FEE=10
#START_COINS=100
#RESULT_HOLD=9000

# ---------------------------------------------------------------------------
# A second region (optional)
#
# Leave DATABASE_URL blank and this server keeps everything in its own JSON
# file, which is all one region ever needs.
#
# Set it on two servers pointing at the same Postgres and they share accounts -
# coins, cursors, the leaderboard - while each keeps its own races. A race
# never crosses between them: at ninety milliseconds across the Atlantic it
# would not be worth racing, and whoever was further away would lose every gem
# to the relay. So players reach the server nearest them and meet the people
# already there.
#
# Both servers must also share SESSION_SECRET, or the same player is two
# different accounts, and each needs its own PUBLIC_URL registered in the
# Google console.
#DATABASE_URL=postgres://user:pass@host:25060/cursorrace?sslmode=require
#DATABASE_POOL=6
#DATABASE_NO_SSL=      # set to 1 only for a database on the same machine
#REGION=fra            # which one this server is

# Cookies are per host, so play.example.com and us.example.com would each hand
# the same player a different id and sharing SESSION_SECRET would buy nothing.
# Set this to the parent domain and both can read the one cookie.
#COOKIE_DOMAIN=.example.com

# Every server a player could choose, as id|name|origin. Name more than one and
# the page times each from the player's own browser, starts them on the quickest
# and offers the list in the corner. Leave it blank and there is no picker.
#REGIONS=fra|Frankfurt|https://play.example.com,nyc|New York|https://us.example.com
#SHARED_POLL_MS=3000   # how often to pick up the other region's changes

# ---------------------------------------------------------------------------
# The hoardings (optional)
#
# Where the desk runs (github.com/Outzu/cursorclash-billboard). Set it and this
# server fetches what is up
# once a minute, hands the pictures to its players from its own origin and
# reports how often each was seen. BOARDS_KEY is the desk's GAME_KEY.
#BOARDS_URL=https://billboard.cursorclash.com
#BOARDS_KEY=

# ---------------------------------------------------------------------------
# The chat (optional settings)
#
# Everyone on the home screen shares one chat; with DATABASE_URL set it spans
# the regions through a `chat` table made at start. Anyone can read it, a
# signed-in player can talk. The Google emails listed here can take a line
# down, which also keeps its author quiet for a day.
#CHAT_ADMINS=you@example.com
#CHAT_POLL_MS=1500      # how often to pick up the other region's lines
