# Copied to /etc/cursor-race.env by setup.sh (mode 600, root only).
# Restart after editing: sudo systemctl restart cursor-race

PORT=8080
NODE_ENV=production

# The origin players reach you on. Google redirects back here, so it must match
# the Authorised redirect URI in the Google console (plus /auth/google/callback).
PUBLIC_URL=https://example.com

# Keeps sessions valid across restarts. setup.sh generates one if left blank.
SESSION_SECRET=

# Leave both blank to run without Google sign-in; everyone plays as a guest.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Game tuning, all optional.
#TABLE_CAP=10
#JOIN_WINDOW=30000
#ENTRY_FEE=10
#START_CREDITS=100
#RESULT_HOLD=9000
